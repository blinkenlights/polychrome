# Gravity deployment — environment file
# Copy to .env and fill in real values.
#
# These variables are shared between both app instances (polychrome-woodstock
# and polychrome-pixie) via `env_file: .env` in docker-compose.yml.
#
# Per-service settings (PORT, INSTALLATION_MODULE, BOOT_APP, BOOT_APP_MODE,
# DATABASE_PATH, PHX_URL_PORT, PHX_URL_SCHEME) are set directly in
# docker-compose.yml and do NOT belong here.

PHX_HOST=gravity.crested-frog.ts.net
POOL_SIZE=5

# Secret key base for the Woodstock Phoenix instance.
# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=REPLACE_WITH_WOODSTOCK_SECRET

# Secret key base for the Pixie Phoenix instance.
# Referenced as ${PIXIE_SECRET_KEY_BASE} in docker-compose.yml.
# Generate with: mix phx.gen.secret
PIXIE_SECRET_KEY_BASE=REPLACE_WITH_PIXIE_SECRET
