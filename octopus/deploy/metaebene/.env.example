# Copy to .env and fill in real values before deploying.
# .env is gitignored — never commit it.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname served by Caddy
PHX_HOST=polychrome.metaebene.org

# URL config — Caddy terminates TLS, so Phoenix must generate https:// URLs
PHX_URL_PORT=443
PHX_URL_SCHEME=https

# Internal HTTP port the app binds to (Caddy proxies to this)
PORT=4002

# SQLite database path inside the container (mounted volume)
DATABASE_PATH=/data/octopus.db

# Installation profile (compile-time build arg, kept here for documentation)
# Passed as --build-arg to docker build, not at runtime.
# INSTALLATION_MODULE=Octopus.Installation.Nation2025

# Radar setup to load from config/radar.exs (the "metaebene" setup has no
# radar hardware and is disabled).
RADAR_SETUP=metaebene

# Optional features
# TELEGRAM_BOT_SECRET=
# SKIP_MIGRATIONS=false
