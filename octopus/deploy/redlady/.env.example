# Copy to .env and fill in real values before deploying.
# .env is gitignored — never commit it.

# Generate with: mix phx.gen.secret
SECRET_KEY_BASE=

# Public hostname (the Tailscale hostname)
PHX_HOST=redlady.crested-frog.ts.net

# URL config — Caddy terminates TLS, so Phoenix must generate https:// URLs
PHX_URL_PORT=443
PHX_URL_SCHEME=https

# Internal HTTP port the app binds to (Caddy proxies to this)
PORT=4000

# SQLite database path inside the container (mounted volume)
DATABASE_PATH=/data/octopus.db

# Installation profile (compile-time Docker build arg — see deploy/common/build-image.sh)
INSTALLATION_MODULE=Octopus.Installation.Nation2026

# Radar needs no env: config/radar.exs selects this host's sensor bindings by
# hostname ("redlady") and prod defaults to live. Set RADAR_SOURCE_MODE only to
# override the boot mode (off|live|exact|fuzzy).

# Optional features
# TELEGRAM_BOT_SECRET=
# SKIP_MIGRATIONS=false
