import Config

# Copy to radar.local.exs (gitignored) for machine-specific overrides.
# Loaded after radar.exs in config/runtime.exs.

# Disable radar entirely on this host:
# config :octopus, Octopus.Radar, enabled: false

# Mac dev example (CH340 / CP210x). Circuits.UART uses tty.* :
# ls /dev/tty.usbserial-* /dev/cu.usbserial-*
#
# config :octopus, Octopus.Radar,
#   sensors: [
#     [port: "/dev/tty.usbserial-0001", angle_deg: 0, distance_cm: 0, rotation_deg: 0]
#   ],
#   defaults: [
#     height_cm: 300
#   ]

# Example: three sensors around an installation center (pose values are illustrative):
#
# config :octopus, Octopus.Radar,
#   sensors: [
#     [port: "/dev/ttyUSB0", angle_deg: 0, distance_cm: 0, rotation_deg: 0],
#     [port: "/dev/ttyUSB1", angle_deg: 120, distance_cm: 150, rotation_deg: 120],
#     [port: "/dev/ttyUSB2", enabled: false]
#   ]

# Raspberry Pi example:
#
# config :octopus, Octopus.Radar,
#   sensors: [
#     [port: "/dev/ttyUSB0"],
#     [port: "/dev/ttyUSB1"]
#   ]
